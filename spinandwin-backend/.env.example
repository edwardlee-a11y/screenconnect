# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Your deployed Expo/frontend URL (e.g. https://yourapp.railway.app)
# In dev just put http://localhost:8081
FRONTEND_URL=http://localhost:8081

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_random_hex_string

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
# SUPABASE_URL     → "Project URL"
# SUPABASE_SERVICE_KEY → "service_role" key (NOT the anon key)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Upstash Redis ────────────────────────────────────────────────────────────
# console.upstash.com → your database → REST API section
UPSTASH_REDIS_URL=https://xxxx.upstash.io
UPSTASH_REDIS_TOKEN=your_upstash_token_here

# ─── Firebase Admin ───────────────────────────────────────────────────────────
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# Open the downloaded JSON and copy these three fields exactly
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@your-project-id.iam.gserviceaccount.com
# Copy the "private_key" value from the JSON — keep the \n characters as-is
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----\n"

# ─── Alchemy ──────────────────────────────────────────────────────────────────
# dashboard.alchemy.com → Create App → Polygon Amoy (testnet) or Polygon Mainnet
ALCHEMY_API_KEY=your_alchemy_api_key_here

# ─── Polygon / Smart Contract ─────────────────────────────────────────────────
# POLYGON_PRIVATE_KEY: the private key of your deployer/hot wallet
# ⚠️  NEVER commit this. Use Railway's environment variable secrets.
# Get from MetaMask → Account Details → Export Private Key
POLYGON_PRIVATE_KEY=0xabc123...your_wallet_private_key

# Address of your deployed SpinAndWin.sol contract on Polygon Amoy
POLYGON_CONTRACT_ADDRESS=0x...your_contract_address

# MATIC/USD rate — fallback when Chainlink is unavailable (local dev / testnet)
MATIC_USD_RATE=0.85

# ─── Chainlink Price Feed (optional overrides) ────────────────────────────────
# Defaults point to official Polygon feeds — only set these to override
# CHAINLINK_MATIC_USD_FEED=0xAB594600376Ec9fD91F8e885dADF0CE036862dE          # mainnet
# CHAINLINK_MATIC_USD_FEED_TESTNET=0x001382149eBa3441043c1c66972b4772963f5D43  # amoy

# ─── Email (Nodemailer SMTP) ──────────────────────────────────────────────────
# Leave EMAIL_HOST empty in development → Ethereal fake SMTP is used automatically
# (emails are captured at https://ethereal.email — no real mail sent)
#
# SendGrid (production):
#   EMAIL_HOST=smtp.sendgrid.net  EMAIL_PORT=587  EMAIL_USER=apikey  EMAIL_PASS=<API_KEY>
# Gmail (App Password):
#   EMAIL_HOST=smtp.gmail.com  EMAIL_PORT=587  EMAIL_USER=you@gmail.com  EMAIL_PASS=<APP_PASS>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=Spin & Win <noreply@spinandwin.app>
APP_URL=https://spinandwin.app

# ─── Admin dashboard ─────────────────────────────────────────────────────────
# Static secret for /api/v1/admin/* endpoints — pass as X-Admin-Secret header
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SECRET=REPLACE_WITH_RANDOM_SECRET

# ─── Sentry (error monitoring) ────────────────────────────────────────────────
# sentry.io → Create Project → Node.js → copy the DSN
SENTRY_DSN=https://YOUR_KEY@oXXXXXX.ingest.sentry.io/XXXXXXX

# ─── Polygonscan (contract verification) ─────────────────────────────────────
POLYGONSCAN_API_KEY=your_polygonscan_api_key
